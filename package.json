{
  "name": "@leandromatos/prettier-config",
  "version": "2.2.0",
  "description": "Prettier configuration with Tailwind CSS class sorting.",
  "keywords": [
    "prettier",
    "config"
  ],
  "license": "MIT",
  "author": "Leandro Matos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandromatos/prettier-config.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "!src/__tests__",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "pnpm run clean:build && pnpm run compile",
    "clean:build": "rm -f src/index.d.ts",
    "compile": "tsc --project tsconfig.build.json",
    "lint": "pnpm run lint:ts && pnpm run lint:js && pnpm run lint:md",
    "lint:ts": "tsc --project tsconfig.json",
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:fix": "pnpm run lint:fix:js && pnpm run lint:fix:md",
    "lint:fix:js": "eslint . --fix",
    "lint:fix:md": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "test": "pnpm run test:js && pnpm run test:sh",
    "test:js": "vitest run",
    "test:sh": "bats --recursive scripts/release/__tests__",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "release:snapshot": "./scripts/release/snapshot.sh",
    "release:production": "./scripts/release/production.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "peerDependencies": {
    "prettier": ">=3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@leandromatos/commitlint-config": "^1.1.1",
    "@leandromatos/eslint-config": "^3.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "bats": "^1.13.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
