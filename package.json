{
  "name": "@leandromatos/prettier-config",
  "version": "2.0.2",
  "description": "Prettier configuration with Tailwind CSS class sorting.",
  "keywords": [
    "prettier",
    "config"
  ],
  "license": "MIT",
  "author": "Leandro Matos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandromatos/prettier-config.git"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "yarn clean:build && yarn compile",
    "clean:build": "rm -f index.d.ts",
    "compile": "tsc --project tsconfig.json",
    "lint": "yarn lint:ts && yarn lint:js",
    "lint:ts": "tsc --project tsconfig.json --noEmit",
    "lint:js": "eslint .",
    "lint:fix": "yarn lint:fix:js",
    "lint:fix:js": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage",
    "release:snapshot": "./scripts/release/snapshot.sh",
    "release:production": "./scripts/release/production.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "peerDependencies": {
    "prettier": ">=3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@leandromatos/commitlint-config": "^1.0.0",
    "@leandromatos/eslint-config": "^3.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
